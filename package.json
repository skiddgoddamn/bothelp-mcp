{
  "name": "bothelp-mcp",
  "version": "0.1.2",
  "description": "MCP server to read and BUILD BotHelp bot scenarios (Telegram/VK/MAX/WhatsApp) via the constructor's private WebSocket-RPC. Zero-dependency on Node >=22.",
  "type": "module",
  "bin": { "bothelp-mcp": "src/index.mjs" },
  "main": "src/index.mjs",
  "files": ["src", ".mcp.json", ".claude-plugin", "README.md", "LICENSE"],
  "scripts": {
    "start": "node src/index.mjs",
    "check": "node --check src/index.mjs",
    "test": "node scripts/smoke.mjs"
  },
  "engines": { "node": ">=22" },
  "keywords": ["mcp", "bothelp", "telegram", "bot", "funnel", "scenario", "flow-builder", "claude-code", "model-context-protocol"],
  "repository": { "type": "git", "url": "git+https://github.com/skiddgoddamn/bothelp-mcp.git" },
  "homepage": "https://bothelp.io",
  "license": "MIT"
}
